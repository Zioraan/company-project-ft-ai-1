# Dependencies
node_modules/
.pnp
.pnp.*

# Package manager artifacts
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build and test output
coverage/
dist/
build/
.cache/
.turbo/
*.tsbuildinfo

# Framework output
.next/
out/

# Environment files (never commit real secrets; use *.example templates only)
.env
.env.*
.env*
!**/.env.example
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
.vscode-test/

# Local scratch files
tmp-*.txt

# Deployment
.vercel/

# Python cache (for mixed repos)
__pycache__/
.venv/
venv/

# Runtime TinyDB storage
services/api/data/

# Sales forecast generated artifacts (keep directory via .gitkeep)
data/artifacts/sales_forecast/*
!data/artifacts/sales_forecast/.gitkeep
!data/artifacts/sales_forecast/README.md
