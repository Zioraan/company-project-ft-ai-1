# Public API base URL used by the talent tracker frontend.
# NEXT_PUBLIC_API_URL=https://playground.4geeks.com/tracker/api/v1

# Platform API (FastAPI service in services/api).
NEXT_PUBLIC_INCIDENTS_API_URL=http://localhost:8000

# Backoffice origin for password reset links (must match running dev server).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Telemetry ingest (Phase 2A stub on platform API).
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
