# Docker Compose runtime template
# Copy to .env at the repository root and fill required values before: docker compose up

# --- Backend (backend service) ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:3001/reset-password

# Supabase PostgreSQL (required for inventory)
# Format (pooler): postgresql+psycopg2://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Resend (optional in dev — reset links log to server console without a key)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Comma-separated browser origins allowed by FastAPI CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Telemetry ingest (Phase 2A stub)
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# --- Frontend (ui service; consumed in the host browser) ---
NEXT_PUBLIC_INCIDENTS_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
