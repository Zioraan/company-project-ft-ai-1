JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:3001/reset-password

# Resend (optional in dev — reset links log to server console without a key)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Supabase PostgreSQL (Company-Milestone project)
# Format (pooler, recommended): postgresql+psycopg2://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Direct (IPv6-only on some networks): postgresql+psycopg2://postgres:[password]@db.tucrpazizfmtwucngvvu.supabase.co:5432/postgres
DATABASE_URL=

