JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# Resend (optional in dev — reset links log to server console without a key)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional persistence overrides
# SUPPLIERS_DB_PATH=services/api/data/suppliers.json
# USERS_DB_PATH=services/api/data/users.json
